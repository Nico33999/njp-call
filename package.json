{
  "name": "njp-call",
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "service": "tsx service/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.core.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check core service tests scripts extension",
    "package:build": "tsx scripts/build-package.ts",
    "package:verify": "tsx scripts/verify-package.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "ci": "pnpm typecheck && pnpm test && pnpm build && pnpm package:build && pnpm package:verify && pnpm check:secrets"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "pnpm": "^10.15.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  },
  "private": true,
  "description": "NJP CALL — extension officielle NJP CARE : secrétaire vocale automatisée du cabinet (moteur, service 24/7, configurateur, paquet signé)."
