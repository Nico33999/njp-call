# NJP CALL — gabarit d'environnement. AUCUNE valeur réelle ici.
# Les secrets viennent du coffre de secrets de l'hébergement, jamais du dépôt.
# Préparer ce fichier n'autorise pas à déployer (voir docs/EXPLOITATION.md §0).

# recette (simulateur) | operationnel (refusé tant qu'aucun fournisseur réel n'existe)
NJP_CALL_MODE=recette

# Stockage durable (obligatoire en operationnel)
NJP_CALL_DB_PATH=/var/lib/njp-call/service.db
# 64 caractères hexadécimaux — openssl rand -hex 32 — À CONSERVER À PART : sans elle, les sauvegardes sont illisibles
NJP_CALL_STORAGE_KEY=
NJP_CALL_RETENTION_DAYS=30

# Fournisseur téléphonique (ici : simulateur) — secret HMAC >= 32 caractères
NJP_CALL_TELEPHONY_WEBHOOK_SECRET=

# Postes NJP CARE : EMPREINTES sha256 des jetons, jamais les jetons.
# Rotation : deux empreintes pour le même cabinet pendant la bascule.
NJP_CALL_DEVICE_TOKENS_FILE=/etc/njp-call/device-tokens
# Numéro appelé -> cabinet
NJP_CALL_NUMBER_ROUTES=
# Configurations PUBLIQUES des cabinets (<cabinetId>.json)
NJP_CALL_CONFIG_DIR=/etc/njp-call/cabinets

# IA : désactivée sans les quatre valeurs ET l'empreinte approuvée
# NJP_CALL_LLM_ENDPOINT=
# NJP_CALL_LLM_API_KEY=
# NJP_CALL_LLM_MODEL=
# NJP_CALL_LLM_ALLOWED_HOSTS=
# NJP_CALL_LLM_APPROVED_FINGERPRINT=

# Écoute locale, derrière un frontal TLS
HOST=127.0.0.1
PORT=8787
